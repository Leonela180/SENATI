APP_ENV=development
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Ejemplo: postgresql+psycopg://lumia_app:TU_CLAVE@localhost:5432/lumia   (no uses el carácter % en la clave)
DATABASE_URL=
PRIVATE_STORAGE_ROOT=./private_data
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=24000000
# mock = simulación SIN IA real (para probar el circuito) · local = Stable Diffusion 1.5 en la GPU
AI_ENGINE=mock
AI_MODEL_ID=stable-diffusion-v1-5
AI_MODEL_PATH=./models/stable-diffusion-v1-5
AI_WORKER_CONCURRENCY=1
FRONTEND_ORIGIN=http://localhost:5173
# Generar imágenes con Gemini (servicio EXTERNO de Google). Pega tu clave solo aquí, nunca en el código ni en el chat.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Chat del Asistente (texto). Usa la misma GEMINI_API_KEY.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Modelo para recortar el fondo en el Estudio (se descarga una vez a models/rembg, ~170 MB)
LUMIA_SEGMENT_MODEL=u2net
APP_TZ_OFFSET_HOURS=-5
# Compartir por internet con scripts/compartir.ps1 (1 = activado). Déjalo en 0 si no compartes.
TRUST_PROXY=0
